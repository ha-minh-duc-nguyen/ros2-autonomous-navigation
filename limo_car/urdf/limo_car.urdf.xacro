    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="front_face_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="front_bumper_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="rear_bumper_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_skirt_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_skirt_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_toolbox_link">
    <material>Gazebo/DarkRed</material>
  </gazebo>

  <gazebo reference="right_toolbox_link">
    <material>Gazebo/DarkRed</material>
  </gazebo>

  <gazebo reference="front_grille_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_front_arch_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="right_front_arch_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="left_rear_arch_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="right_rear_arch_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="rear_equipment_box_link">
    <material>Gazebo/DarkRed</material>
  </gazebo>

  <gazebo reference="headlight_left_link">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="headlight_right_link">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="taillight_left_link">
