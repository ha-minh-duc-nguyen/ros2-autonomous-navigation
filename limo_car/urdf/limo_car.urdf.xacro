<?xml version="1.0"?>
<robot name="limo_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
  =====================================================================
  FINAL MINI FIRE-TRUCK STYLE LIMO ROBOT
 
  Goals:
    1) Keep AWD-style movement exactly as before
       - front diff drive plugin
       - rear diff drive plugin
       - same cmd_vel control
    2) Improve the visual appearance to resemble a mini firefighter truck
    3) Keep the physics body simple and stable for Gazebo
    4) Use separate visual links so Gazebo Classic can display colors better

  Notes:
    - base_link is kept as the main physical body
    - many decorative parts are visual-only fixed links
    - colors are assigned both in URDF materials and Gazebo Classic materials
    - wheel and lidar links are NOT overridden by Gazebo material blocks,
      so their sub-visual colors remain visible
  =====================================================================
  -->

  <!-- ================================================================
       1) BASIC DIMENSIONS / PARAMETERS
       These values define the main robot size and sensor sizes.
  ================================================================= -->
  <xacro:property name="wheel_radius" value="0.045"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheel_separation" value="0.097"/>

  <xacro:property name="base_length" value="0.254"/>
  <xacro:property name="base_width" value="0.127"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_clearance" value="0.02"/>

  <xacro:property name="base_mass" value="4.8"/>
  <xacro:property name="wheel_mass" value="0.30"/>

  <!-- LiDAR made smaller to fit the vehicle proportions better -->
  <xacro:property name="lidar_radius" value="0.022"/>
  <xacro:property name="lidar_height" value="0.024"/>

  <!-- LiDAR mounted near the front-top area -->
  <xacro:property name="lidar_x" value="${(base_length/2.0) - 0.04}"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${base_clearance + base_height + (lidar_height/2.0)}"/>

  <!-- ================================================================
       2) MATERIAL DEFINITIONS
       URDF materials for RViz / URDF rendering and fallback visuals.
  ================================================================= -->
  <material name="FireRed">
    <color rgba="0.82 0.05 0.05 1.0"/>
  </material>

  <material name="FireRedDark">
    <color rgba="0.58 0.02 0.02 1.0"/>
  </material>

  <material name="RescueYellow">
    <color rgba="0.96 0.82 0.05 1.0"/>
  </material>

  <material name="CabWhite">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="ChassisBlack">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="TireBlack">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="RimSilver">
    <color rgba="0.76 0.76 0.79 1.0"/>
  </material>

  <material name="HeadlightWhite">
    <color rgba="1.0 0.98 0.90 1.0"/>
  </material>

  <material name="TaillightRed">
    <color rgba="0.95 0.08 0.08 1.0"/>
  </material>

  <material name="LidarWhite">
    <color rgba="0.92 0.92 0.95 1.0"/>
  </material>

  <material name="EmergencyBlue">
    <color rgba="0.05 0.20 0.95 1.0"/>
  </material>

  <material name="GrilleGrey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <material name="ToolSilver">
    <color rgba="0.80 0.80 0.82 1.0"/>
  </material>

  <!-- ================================================================
       3) MAIN PHYSICAL BODY
       Keep this simple for stable Gazebo physics.
       All decorative parts are attached as fixed visual-only links.
  ================================================================= -->
  <link name="base_link">
    <collision>
      <origin xyz="0 0 ${base_clearance + base_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${base_clearance + base_height/2.0}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="0.06" ixy="0.0" ixz="0.0"
        iyy="0.10" iyz="0.0"
        izz="0.12"/>
    </inertial>
  </link>

  <!-- ================================================================
       4) LOWER CHASSIS / BODY BLOCKS
       These create the overall mini fire-truck silhouette.
  ================================================================= -->

  <!-- Lower black hull -->
  <link name="lower_hull_link">
    <visual>
      <origin xyz="0 0 0.052" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} 0.045"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>
  </link>

  <joint name="lower_hull_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lower_hull_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Main red body -->
  <link name="upper_cabin_link">
    <visual>
      <origin xyz="-0.006 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length*0.88} ${base_width*0.88} 0.038"/>
      </geometry>
      <material name="FireRed"/>
    </visual>
  </link>

  <joint name="upper_cabin_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_cabin_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- White roof -->
  <link name="roof_link">
    <visual>
      <origin xyz="-0.006 0 0.116" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length*0.86} ${base_width*0.86} 0.005"/>
      </geometry>
      <material name="CabWhite"/>
    </visual>
  </link>

  <joint name="roof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="roof_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Yellow rescue stripe -->
  <link name="rescue_stripe_link">
    <visual>
      <origin xyz="-0.005 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length*0.82} 0.010 0.010"/>
      </geometry>
      <material name="RescueYellow"/>
    </visual>
  </link>

  <joint name="rescue_stripe_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rescue_stripe_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Front truck face to make the front look less flat -->
  <link name="front_face_link">
    <visual>
      <origin xyz="${base_length/2.0 - 0.004} 0 0.078" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 ${base_width*0.82} 0.060"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>
  </link>

  <joint name="front_face_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_face_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Front bumper -->
  <link name="front_bumper_link">
    <visual>
      <origin xyz="${base_length/2.0 + 0.008} 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 ${base_width + 0.004} 0.034"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>
  </link>

  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rear bumper -->
  <link name="rear_bumper_link">
    <visual>
      <origin xyz="-${base_length/2.0 + 0.008} 0 0.037" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 ${base_width + 0.004} 0.034"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>
  </link>

  <joint name="rear_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_bumper_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Lower side skirts -->
  <link name="left_skirt_link">
    <visual>
      <origin xyz="0 ${base_width/2.0 + 0.0045} 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length + 0.002} 0.009 0.030"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>
  </link>

  <joint name="left_skirt_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_skirt_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_skirt_link">
    <visual>
      <origin xyz="0 -${base_width/2.0 + 0.0045} 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length + 0.002} 0.009 0.030"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>
  </link>

  <joint name="right_skirt_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_skirt_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       5) SIDE TOOL COMPARTMENTS
       Made smaller and slightly higher so they feel more integrated.
  ================================================================= -->
  <link name="left_toolbox_link">
    <!-- Main compartment body -->
    <visual>
      <origin xyz="-0.010 ${base_width/2.0 + 0.0085} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.115 0.010 0.032"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>

    <!-- Door details -->
    <visual>
      <origin xyz="-0.025 ${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="0.010 ${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="0.045 ${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>
  </link>

  <joint name="left_toolbox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_toolbox_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_toolbox_link">
    <visual>
      <origin xyz="-0.010 -${base_width/2.0 + 0.0085} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.115 0.010 0.032"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>

    <visual>
      <origin xyz="-0.025 -${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="0.010 -${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="0.045 -${base_width/2.0 + 0.0145} 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.002 0.020"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>
  </link>

  <joint name="right_toolbox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_toolbox_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       6) FRONT GRILLE
  ================================================================= -->
  <link name="front_grille_link">
    <!-- Main grille face -->
    <visual>
      <origin xyz="${base_length/2.0 + 0.003} 0 0.065" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 ${base_width*0.50} 0.028"/>
      </geometry>
      <material name="GrilleGrey"/>
    </visual>

    <!-- Horizontal grille bars -->
    <visual>
      <origin xyz="${base_length/2.0 + 0.005} 0 0.056" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 ${base_width*0.48} 0.004"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="${base_length/2.0 + 0.005} 0 0.065" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 ${base_width*0.48} 0.004"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>

    <visual>
      <origin xyz="${base_length/2.0 + 0.005} 0 0.074" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 ${base_width*0.48} 0.004"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>
  </link>

  <joint name="front_grille_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_grille_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       7) WHEEL ARCHES
       Reduced height and thickness so they look less blocky.
  ================================================================= -->
  <link name="left_front_arch_link">
    <visual>
      <origin xyz="${base_length/4.0} ${wheel_separation/2.0 + 0.008} 0.058" rpy="0 0 0"/>
      <geometry>
        <box size="0.068 0.008 0.028"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>
  </link>

  <joint name="left_front_arch_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_arch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_front_arch_link">
    <visual>
      <origin xyz="${base_length/4.0} -${wheel_separation/2.0 + 0.008} 0.058" rpy="0 0 0"/>
      <geometry>
        <box size="0.068 0.008 0.028"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>
  </link>

  <joint name="right_front_arch_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_arch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_rear_arch_link">
    <visual>
      <origin xyz="-${base_length/4.0} ${wheel_separation/2.0 + 0.008} 0.058" rpy="0 0 0"/>
      <geometry>
        <box size="0.068 0.008 0.028"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>
  </link>

  <joint name="left_rear_arch_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_rear_arch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_rear_arch_link">
    <visual>
      <origin xyz="-${base_length/4.0} -${wheel_separation/2.0 + 0.008} 0.058" rpy="0 0 0"/>
      <geometry>
        <box size="0.068 0.008 0.028"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>
  </link>

  <joint name="right_rear_arch_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_rear_arch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       8) REAR EQUIPMENT BOX
       Smaller and better aligned to the body.
  ================================================================= -->
  <link name="rear_equipment_box_link">
    <!-- Main rear equipment body -->
    <visual>
      <origin xyz="-0.085 0 0.085" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 ${base_width*0.50} 0.040"/>
      </geometry>
      <material name="FireRedDark"/>
    </visual>

    <!-- Top lid -->
    <visual>
      <origin xyz="-0.085 0 0.098" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 ${base_width*0.44} 0.003"/>
      </geometry>
      <material name="ToolSilver"/>
    </visual>
  </link>

  <joint name="rear_equipment_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_equipment_box_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       9) FRONT / REAR LIGHTS
       Slightly larger so they are easier to read in Gazebo.
  ================================================================= -->
  <link name="headlight_left_link">
    <visual>
      <origin xyz="${base_length/2.0 + 0.003} 0.040 0.048" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.022 0.014"/>
      </geometry>
      <material name="HeadlightWhite"/>
    </visual>
  </link>

  <joint name="headlight_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="headlight_left_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="headlight_right_link">
    <visual>
      <origin xyz="${base_length/2.0 + 0.003} -0.040 0.048" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.022 0.014"/>
      </geometry>
      <material name="HeadlightWhite"/>
    </visual>
  </link>

  <joint name="headlight_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="headlight_right_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="taillight_left_link">
    <visual>
      <origin xyz="-${base_length/2.0 + 0.003} 0.040 0.046" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.022 0.012"/>
      </geometry>
      <material name="TaillightRed"/>
    </visual>
  </link>

  <joint name="taillight_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="taillight_left_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="taillight_right_link">
    <visual>
      <origin xyz="-${base_length/2.0 + 0.003} -0.040 0.046" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.022 0.012"/>
      </geometry>
      <material name="TaillightRed"/>
    </visual>
  </link>

  <joint name="taillight_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="taillight_right_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       10) EMERGENCY ROOF LIGHT BAR
  ================================================================= -->
  <link name="lightbar_link">
    <visual>
      <origin xyz="0.010 0 0.128" rpy="0 0 0"/>
      <geometry>
        <box size="0.070 0.024 0.014"/>
      </geometry>
      <material name="EmergencyBlue"/>
    </visual>
  </link>

  <joint name="lightbar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lightbar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       11) WHEEL MACRO
       Black tire + smaller silver rim.
       No Gazebo wheel-level material override is used later, so both
       visuals can remain visible in Gazebo Classic.
  ================================================================= -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">

      <!-- Outer tire -->
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="TireBlack"/>
      </visual>

      <!-- Inner rim -->
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="${wheel_width + 0.001}"/>
        </geometry>
        <material name="RimSilver"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Wheel placement -->
  <xacro:wheel prefix="front_left"  x="${base_length/4.0}"  y="${wheel_separation/2.0}"/>
  <xacro:wheel prefix="front_right" x="${base_length/4.0}"  y="-${wheel_separation/2.0}"/>
  <xacro:wheel prefix="rear_left"   x="-${base_length/4.0}" y="${wheel_separation/2.0}"/>
  <xacro:wheel prefix="rear_right"  x="-${base_length/4.0}" y="-${wheel_separation/2.0}"/>

  <!-- ================================================================
       12) LiDAR
       Smaller top sensor with dark base.
  ================================================================= -->
  <link name="lidar_link">
    <!-- Main lidar body -->
    <visual>
      <origin xyz="0 0 0.012" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="LidarWhite"/>
    </visual>

    <!-- Lidar base -->
    <visual>
      <origin xyz="0 0 -0.005" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.017" length="0.010"/>
      </geometry>
      <material name="ChassisBlack"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.0001" ixy="0" ixz="0"
        iyy="0.0001" iyz="0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <link name="camera_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.03 0.02"/></geometry><material name="ToolSilver"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.03 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.10 0.0 0.11" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       13) GAZEBO LIDAR SENSOR
  ================================================================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros><namespace>/</namespace><remapping>image_raw:=/front_camera/image_raw</remapping><remapping>camera_info:=/front_camera/camera_info</remapping></ros>
        <camera_name>front_camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================================================================
       14) AWD MOVEMENT (UNCHANGED)
       This is your working motion setup:
         - front axle diff drive
         - rear axle diff drive
         - both use the same cmd_vel
         - only front axle publishes odometry
  ================================================================= -->
  <gazebo>
    <plugin name="front_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="rear_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ================================================================
       15) GAZEBO CLASSIC MATERIAL OVERRIDES
       These are applied only to body-style links.
       We intentionally do NOT override wheel links or lidar_link here,
       so their sub-visual materials remain visible.
  ================================================================= -->
  <gazebo reference="lower_hull_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="upper_cabin_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="roof_link">
    <material>Gazebo/White</material>
  </gazebo>

